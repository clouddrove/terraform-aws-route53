##-----------------------------------------------------------------------------
## Effective Route53 Hosted Zone ID
##-----------------------------------------------------------------------------

output "zone_id" {
  description = "Effective Route53 hosted-zone ID, whether existing or created."
  value       = local.zone_id
}

##-----------------------------------------------------------------------------
## Public Hosted Zone Name Servers
##-----------------------------------------------------------------------------

output "name_servers" {
  description = "Name servers of the newly created public hosted zone."

  value = try(
    aws_route53_zone.public[0].name_servers,
    []
  )
}

##-----------------------------------------------------------------------------
## Hosted Zone ARN
##-----------------------------------------------------------------------------

output "zone_arn" {
  description = "ARN of the effective Route53 hosted zone."

  value = (
    local.zone_id != ""
    ? "arn:${data.aws_partition.current.partition}:route53:::hostedzone/${local.zone_id}"
    : null
  )
}

##-----------------------------------------------------------------------------
## DNS Record FQDNs
##-----------------------------------------------------------------------------

output "record_fqdns" {
  description = "Map of Terraform-managed Route53 record FQDNs."

  value = {
    for key, record in aws_route53_record.this :
    key => record.fqdn
  }
}

##-----------------------------------------------------------------------------
## DNS Record IDs
##-----------------------------------------------------------------------------

output "record_ids" {
  description = "Map of Terraform-managed Route53 record IDs."

  value = {
    for key, record in aws_route53_record.this :
    key => record.id
  }
}

##-----------------------------------------------------------------------------
## CloudDrove Resource Tags
##-----------------------------------------------------------------------------

output "tags" {
  description = "Tags generated by the CloudDrove labels module."
  value       = module.labels.tags
}
